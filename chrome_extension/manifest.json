{
  "manifest_version": 3,
  "name": "Trusted Groups -> Blinkit",
  "version": "1.0",
  "description": "Injects a Trusted Groups cart directly into Blinkit.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
